# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp

# Data files
*.csv
*.pkl
# Images, annotations, downloads and evaluation outputs stay on your computer
/data/*

# Environment variables
.env

# Reports are committed, including their CSV files
!/reports/**/*.csv
/reports/1.0/*.png

# Phone app: generated model and runtime files (rebuild with scripts/export_web.py)
/app/web/models/
/app/web/ort/
/app/web/species_info.json
*.onnx

# Files set aside for deletion
/_to_delete/

# Trained models and run outputs (labels and configs in model/configs_and_labels are committed)
*.keras
*.h5
*.tflite
*.pt
saved_model/
results/
logs/
outputs/
.DS_Store

# Kedro pipelines and MLflow (docs/pipelines.md): local settings, tracking database and artifacts
/conf/local/*
!/conf/local/.gitkeep
/mlflow.db
/mlruns/
/mlartifacts/
/.pytest_cache/
/.viz/
/build/
